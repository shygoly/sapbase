# Database Configuration
# Create DB first: createdb -U mac sapbasic  (or: psql -U mac -d postgres -c "CREATE DATABASE sapbasic;")
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mac
DB_PASSWORD=
DB_NAME=sapbasic
# Development-only schema sync. Production must keep this false and use migrations.
DB_SYNCHRONIZE=true
# off | warn | required. Production should use a non-owner app role and required.
RLS_ENFORCEMENT=off

# Server Configuration
PORT=3051
NODE_ENV=development

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Agent 工具面传输：direct（默认，直连网关）| mcp（内嵌通道经 MCP 客户端）
AGENT_TOOL_TRANSPORT=direct
# 宿主暴露的工具面按 profile 收窄：piagent-runtime（默认）| piagent-builder
AGENT_HOST_PROFILE=piagent-runtime
