{
  "name": "@sap/agent-tools",
  "version": "1.0.0",
  "private": true,
  "description": "PiAgent 工具面：契约加载、确认令牌、工具注册表与 MCP 桥（不含业务实现）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^10.3.0",
    "@nestjs/typeorm": "^10.0.0",
    "@sap/agent-kernel": "*",
    "@sap/platform-core": "*",
    "@sap/platform-release": "*",
    "@sap/shared-core": "*",
    "@speckit/shared-schemas": "*",
    "typeorm": "^0.3.19"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  }
}
