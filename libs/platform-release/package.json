{
  "name": "@sap/platform-release",
  "version": "1.0.0",
  "private": true,
  "description": "平台发布基座：Blueprint 编译/打包、发布生命周期、原子注册与运行时（不含业务域语义）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^7.1.16",
    "@nestjs/typeorm": "^10.0.0",
    "@sap/platform-core": "*",
    "@sap/release-kernel": "*",
    "@sap/shared-core": "*",
    "@speckit/shared-schemas": "*",
    "@speckit/wasm-modules": "*",
    "adm-zip": "^0.5.16",
    "jsonschema": "^1.5.0",
    "redis": "^5.11.0",
    "rxjs": "^7.8.1",
    "semver": "^7.7.4",
    "typeorm": "^0.3.19"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  }
}
