{
  "docs": {
    "domain": "DOMAIN.md",
    "flows": "FLOWS.md",
    "decisions": "DECISIONS.md",
    "agentTools": "AGENT-TOOLS.md"
  },
  "code": {
    "roots": [
      "apps/api/src",
      "apps/web-portal/src",
      "apps/web-console/src",
      "libs",
      "shared-schemas",
      "wasm-modules/src"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".mjs"
    ],
    "ignoreDirs": [
      "node_modules",
      ".next",
      "dist",
      "coverage",
      ".nx",
      ".git"
    ]
  },
  "schema": {
    "kind": "manifest",
    "path": "contracts/schema-manifest.json",
    "tablePrefixes": [],
    "strictDbConstraints": false
  },
  "cron": {
    "registry": "apps/api/src/monitor/scheduled-job.registry.ts",
    "decoratorPatterns": [
      "@Cron\\([^)]*name:\\s*['\"]([^'\"]+)['\"]"
    ]
  },
  "agentTools": {
    "contract": "contracts/tools.json",
    "mcpManifest": "contracts/mcp-tools.json",
    "handlerRoots": [
      "apps/api/src/agent-tools",
      "libs/agent-tools/src"
    ],
    "handlerPattern": "(?:toolName\\s*:\\s*|case\\s+)['\"]([^'\"]+)['\"]",
    "strictHandlers": false
  },
  "sqlDirs": [
    "sql",
    "tools/postgres/init",
    "apps/api/src/migrations"
  ]
}
