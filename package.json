{
  "name": "everythingclaude",
  "version": "1.0.0",
  "description": "Speckit ERP - Monorepo with Frontend and Backend",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared-schemas",
    "wasm-modules",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm run build:libs && concurrently -n portal,console,api -c cyan,magenta,green \"npm run dev --workspace @sap/web-portal\" \"npm run dev --workspace @sap/web-console\" \"npm run start:dev --workspace @sap/api\"",
    "dev:all": "npm run dev",
    "dev:frontend": "npm run dev --workspace @sap/web-portal",
    "dev:backend": "npm run start:dev --workspace @sap/api",
    "wasm:build": "npm run build --workspace @speckit/wasm-modules",
    "wasm:admit": "npm run admit --workspace @speckit/wasm-modules --",
    "wasm:test": "npm run test --workspace @speckit/wasm-modules",
    "wasm:reproducible": "npm run check:reproducible --workspace @speckit/wasm-modules --",
    "build": "npm run build:libs && npm run build --workspace @sap/api && npm run build --workspace @sap/web-portal && npm run build --workspace @sap/web-console",
    "lint": "npm run lint --workspaces",
    "check:domain": "node scripts/meta/check-domain-doc.mjs",
    "check:meta": "node scripts/meta/check-meta-docs.mjs",
    "check:openspec-hygiene": "node scripts/meta/check-openspec-hygiene.mjs",
    "check:agent-tools": "node scripts/meta/check-agent-tools.mjs",
    "check:all": "node scripts/meta/check-all.mjs",
    "check:ci": "node scripts/meta/check-all.mjs --warn-only",
    "nx:graph": "nx graph",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "affected:test": "nx affected -t test",
    "lint:boundaries": "nx graph --file=.nx/boundary-graph.json >/dev/null && eslint \"apps/api/src/**/*.ts\" \"libs/**/*.ts\" \"apps/*/src/**/*.ts\" \"apps/*/src/**/*.tsx\" --no-error-on-unmatched-pattern",
    "check:boundaries": "node scripts/meta/check-boundaries.mjs",
    "test:meta": "node --test scripts/meta/lib/*.test.mjs",
    "test:locale-routing": "node tests/locale-routing.test.js",
    "test:locale-routing:e2e": "node tests/locale-routing.e2e.js",
    "test:auth-login:e2e": "node tests/auth-login.e2e.js",
    "test:patch-dsl": "node --test tests/patch-dsl.test.js",
    "test:notification-center": "node --test tests/notification-center.test.js",
    "test:notification-center:e2e": "node tests/notification-center.e2e.js",
    "test:piagent-shell": "node --test tests/piagent-shell.test.js",
    "test:piagent-shell:e2e": "node tests/piagent-shell.e2e.js",
    "test:module-registry:e2e": "node tests/module-registry.e2e.js",
    "test:search:e2e": "node tests/search.e2e.js",
    "test:evolution:e2e": "node tests/evolution.e2e.js",
    "test:release-evolution:e2e": "node tests/release-evolution.e2e.js",
    "test:review-approval:e2e": "node tests/review-approval.e2e.js",
    "test:async-consumers:e2e": "node tests/async-consumers.e2e.js",
    "check:links": "node scripts/meta/check-doc-links.mjs",
    "meta:openspec-ledger": "node scripts/meta/openspec-ledger.mjs",
    "check:openspec-ledger": "node scripts/meta/openspec-ledger.mjs --check",
    "dev:portal": "npm run dev --workspace @sap/web-portal",
    "dev:console": "npm run dev --workspace @sap/web-console",
    "build:web": "npm run build --workspace @sap/web-portal && npm run build --workspace @sap/web-console",
    "typecheck": "npm run typecheck --workspace @sap/api",
    "build:libs": "npm run build --workspace @sap/shared-core && npm run build --workspace @sap/shared-schemas && npm run build --workspace shared-schemas && npm run build --workspace @speckit/wasm-modules && npm run build --workspace @sap/release-kernel && npm run build --workspace @sap/agent-kernel && npm run build --workspace @sap/platform-core && npm run build --workspace @sap/platform-release && npm run build --workspace @sap/agent-tools && npm run build --workspace @sap/domain-shipping",
    "check:auth-permissions": "node scripts/meta/check-auth-permissions.mjs",
    "ci": "bash scripts/ci/pipeline.sh",
    "ci:record-evidence": "node scripts/ci/record-test-evidence.mjs",
    "e2e": "node scripts/e2e-release-agent.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nx/eslint": "^24.0.2",
    "@nx/eslint-plugin": "^24.0.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "markdownlint-cli": "^0.47.0",
    "nx": "^24.0.2"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "nuqs": "2.8.8"
  }
}
