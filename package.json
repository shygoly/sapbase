{
  "name": "everythingclaude",
  "version": "1.0.0",
  "description": "Speckit ERP - Monorepo with Frontend and Backend",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared-schemas",
    "backend",
    "wasm-modules",
    "libs/*"
  ],
  "scripts": {
    "dev": "concurrently -n portal,console,backend -c cyan,magenta,green \"npm run dev --workspace @sap/web-portal\" \"npm run dev --workspace @sap/web-console\" \"npm run start:dev --workspace speckit-backend\"",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev --workspace speckit\" \"npm run start:dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace @sap/web-portal",
    "dev:backend": "npm run start:dev --workspace backend",
    "wasm:build": "npm run build --workspace @speckit/wasm-modules",
    "wasm:admit": "npm run admit --workspace @speckit/wasm-modules --",
    "wasm:test": "npm run test --workspace @speckit/wasm-modules",
    "wasm:reproducible": "npm run check:reproducible --workspace @speckit/wasm-modules --",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "check:domain": "node scripts/meta/check-domain-doc.mjs",
    "check:meta": "node scripts/meta/check-meta-docs.mjs",
    "check:agent-tools": "node scripts/meta/check-agent-tools.mjs",
    "check:all": "node scripts/meta/check-all.mjs",
    "check:ci": "node scripts/meta/check-all.mjs --warn-only",
    "nx:graph": "nx graph",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "affected:test": "nx affected -t test",
    "lint:boundaries": "nx graph --file=.nx/boundary-graph.json >/dev/null && eslint \"backend/src/**/*.ts\" \"libs/**/*.ts\" \"apps/*/src/**/*.ts\" \"apps/*/src/**/*.tsx\" --no-error-on-unmatched-pattern",
    "check:boundaries": "node scripts/meta/check-boundaries.mjs",
    "test:meta": "node --test scripts/meta/lib/*.test.mjs",
    "check:links": "node scripts/meta/check-doc-links.mjs",
    "dev:portal": "npm run dev --workspace @sap/web-portal",
    "dev:console": "npm run dev --workspace @sap/web-console",
    "build:web": "npm run build --workspace @sap/web-portal && npm run build --workspace @sap/web-console"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nx/eslint": "^24.0.2",
    "@nx/eslint-plugin": "^24.0.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "markdownlint-cli": "^0.47.0",
    "nx": "^24.0.2"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "nuqs": "2.8.8"
  }
}
