{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/ai-definition-object-model.schema.json",
  "title": "AI Definition Step 1 — Object Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "fields"],
        "properties": {
          "identifier": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "label": { "type": "string" },
                "description": { "type": "string" },
                "type": {
                  "enum": [
                    "string",
                    "text",
                    "number",
                    "int",
                    "integer",
                    "decimal",
                    "money",
                    "boolean",
                    "bool",
                    "date",
                    "datetime",
                    "timestamp",
                    "i32",
                    "reference",
                    "enum"
                  ]
                },
                "required": { "type": "boolean" },
                "reference": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
