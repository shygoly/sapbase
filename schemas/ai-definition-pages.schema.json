{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/ai-definition-pages.schema.json",
  "title": "AI Definition Step 4 — Pages",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "type", "entity"],
        "properties": {
          "identifier": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "type": { "enum": ["list", "form", "detail"] },
          "entity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
        }
      }
    }
  }
}
