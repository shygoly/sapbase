{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/ai-definition-reports.schema.json",
  "title": "AI Definition Step 6 — Reports",
  "type": "object",
  "additionalProperties": false,
  "required": ["reports"],
  "properties": {
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "entities"],
        "properties": {
          "identifier": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "entities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
          }
        }
      }
    }
  }
}
