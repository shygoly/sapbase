{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/ai-definition-state-flow.schema.json",
  "title": "AI Definition Step 3 — State Flow",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "initial": { "type": "boolean" },
          "final": { "type": "boolean" },
          "transitions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "metadata": { "type": "object" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "guard": { "type": "string" },
          "action": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "anyOf": [
          { "required": ["from", "to"] },
          { "required": ["source", "target"] }
        ]
      }
    },
    "entities": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "anyOf": [
    { "required": ["states"] },
    { "required": ["entities"] }
  ]
}
