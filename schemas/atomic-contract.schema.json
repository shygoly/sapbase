{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/atomic-contract.schema.json",
  "title": "Atomic Contract",
  "description": "原子契约 —— 一个最小业务能力的接口与约束。契约与实现解耦：同一契约可有 TypeScript 实现（平台自研，跑在内核）与 Wasm 实现（可交付，跑在零能力沙箱）。v1 只允许 calculation / query 两类，写入型原子（command / effect）需要事务与补偿设计，另立变更。",
  "type": "object",
  "additionalProperties": false,
  "required": ["atomicType", "version", "kind", "inputSchema", "outputSchema"],
  "properties": {
    "atomicType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "原子类型标识（kebab-case），如 available-inventory"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "语义化版本；同一 atomicType 下多个版本可共存"
    },
    "kind": {
      "enum": ["calculation", "query"],
      "description": "v1 仅允许计算型与查询型"
    },
    "description": { "type": "string", "maxLength": 500 },
    "status": {
      "enum": ["draft", "active", "deprecated"],
      "default": "draft"
    },
    "inputSchema": { "$ref": "#/$defs/projection" },
    "outputSchema": { "$ref": "#/$defs/output" },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" },
      "uniqueItems": true,
      "default": [],
      "description": "调用该原子所需的权限点，复用现有 RBAC"
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "uniqueItems": true,
      "default": [],
      "description": "契约错误码；运行时不返回未声明的错误码"
    },
    "idempotency": {
      "enum": ["none", "requestId"],
      "default": "none"
    },
    "cpuBudget": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 100000000000,
      "description": "可选：该原子的执行预算（fuel 指令单位）。声明后执行引擎按此预算计量并中断；未声明时取平台默认（ATOMIC_DEFAULT_FUEL）。"
    },
    "outputAudit": {
      "enum": ["off", "standard", "strict"],
      "default": "standard",
      "description": "闸 3（输出管控）的档位。判据见 docs/protocols/atomic-output-audit.md；off 表示不跑追加判据（既有大小上限检查不受影响）。"
    },
    "implementation": { "$ref": "#/$defs/implementation" }
  },
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns"],
      "description": "输入投影。模块只接收整数列 —— 标识类字段（物料号、单据号、租户 ID）MUST NOT 进入模块；宿主按下标建立映射并在调用后回填。",
      "properties": {
        "rows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "minLength": 1, "description": "行集合来源表达式，如 $lines" },
            "max": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 100000 }
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "source": { "type": "string", "minLength": 1, "description": "字段来源表达式" },
              "type": { "enum": ["i32"], "description": "ABI v1 只支持 32 位整数列" }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "description": "输出布局，对应 ABI v1 的 [columns: i32[n]] [total: i32]。",
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "type": { "enum": ["i32"] },
              "minimum": { "type": "integer" },
              "maximum": { "type": "integer" }
            }
          }
        },
        "total": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
          }
        },
      "maxOutputBytes": {
        "type": "integer",
        "minimum": 4,
        "maximum": 67108864,
        "default": 1048576,
        "description": "输出区上限，超过即拒并记审计"
      },
      "commutative": {
        "type": "boolean",
        "default": false,
        "description": "声明该原子对输入行序可交换：打乱行序后输出行应随之重排、汇总位不变。声明后闸 3 才判置换不变（O5）；未声明即记「未判」，不默认通过。"
      }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "实现绑定。kind = wasm 时必须提供 moduleSha256 / abiVersion / tier，使『客户同意跑的那一份代码』可被指认。",
      "properties": {
        "kind": { "enum": ["typescript", "wasm"] },
        "moduleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "abiVersion": { "const": 1 },
        "tier": { "enum": ["A", "B"], "description": "A = 平台自研；B = 第三方交源码、平台复现构建 + 审查。不设 Tier C。" },
        "reproducibleBuildRef": { "type": "string" },
        "review": { "$ref": "#/$defs/review" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "wasm" } }, "required": ["kind"] },
          "then": { "required": ["moduleSha256", "abiVersion", "tier"] }
        },
        {
          "if": { "properties": { "tier": { "const": "B" } }, "required": ["tier"] },
          "then": { "required": ["review", "reproducibleBuildRef"] }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewedAt", "reproducibleBuildRef", "confidential"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "reproducibleBuildRef": { "type": "string", "minLength": 1 },
        "confidential": { "type": "boolean" },
        "signature": { "type": "string" }
      }
    }
  }
}
