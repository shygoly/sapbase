{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/atomic-module-manifest.schema.json",
  "title": "Atomic Module Manifest",
  "description": "Wasm 原子模块的准入清单（wasm-modules/build/manifest.json）。它是准入记录，不是许可：签名与授权由控制面按 License Protocol 另行处理。宿主导入时 MUST 对模块字节重算 SHA-256，与清单声明比对，不得采信清单自述值。",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedBy", "modules"],
  "properties": {
    "generatedBy": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomicType",
        "file",
        "tier",
        "abiVersion",
        "sha256",
        "sizeBytes",
        "compiler",
        "language",
        "reproducibleBuildRef",
        "staticGate"
      ],
      "properties": {
        "atomicType": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.wasm$" },
        "tier": { "enum": ["A", "B"] },
        "abiVersion": { "const": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 8, "maximum": 2097152 },
        "language": { "enum": ["rust", "assemblyscript"] },
        "reproducibleBuildRef": { "type": "string", "minLength": 1 },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "staticGate": { "$ref": "#/$defs/staticGate" }
      }
    },
    "staticGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteLength", "memoryPages", "exports", "abiVersionExportKind", "checks"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 8 },
        "memoryPages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1, "maximum": 1024 }
          }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "run" }
        },
        "abiVersionExportKind": { "enum": ["function", "global"] },
        "checks": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "逐条通过的检查项，供审计留痕"
        }
      }
    }
  }
}
