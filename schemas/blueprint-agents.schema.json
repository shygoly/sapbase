{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/blueprint-agents.schema.json",
  "title": "Blueprint Agents Layer",
  "description": "Agent 定义（声明式）：只描述 profile/模型/工具/角色/确认策略，不执行任意脚本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["agents", "items"],
  "properties": {
    "agents": { "const": "blueprint-agents/v1" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "prompt", "tools", "roles"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "model": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "roles": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "confirmWrites": { "type": "boolean" },
          "dataScope": { "type": "string" }
        }
      }
    }
  }
}
