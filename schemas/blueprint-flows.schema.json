{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/blueprint-flows.schema.json",
  "title": "Blueprint Flows Layer",
  "description": "包内 flows.json 的形状。**v1 规定 flow 是 DAG**：步骤图不得成环（需要回环的场景用事件再次触发流程表达）。动作形状与 IR 的动作一致（有测试保证两者同步）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["flows"],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entity", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "entity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "on", "actions"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "on": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "next": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
                },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/action" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["check", "require-approval", "post-accounting"] },
        "atomic": { "type": "string" },
        "rule": { "type": "string" },
        "entry": { "type": "string" },
        "when": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "check" } }, "required": ["kind"] },
          "then": { "required": ["atomic"] }
        },
        {
          "if": { "properties": { "kind": { "const": "require-approval" } }, "required": ["kind"] },
          "then": { "required": ["rule"] }
        },
        {
          "if": { "properties": { "kind": { "const": "post-accounting" } }, "required": ["kind"] },
          "then": { "required": ["entry"] }
        }
      ]
    }
  }
}
