{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/blueprint-permissions.schema.json",
  "title": "Blueprint Permissions Layer",
  "description": "角色 → 资源 → 数据范围的发布模型。v1 作为声明随包发布；前端导航/页面守卫消费，服务端按角色映射后执行。",
  "type": "object",
  "additionalProperties": false,
  "required": ["permissions", "rules"],
  "properties": {
    "permissions": { "const": "blueprint-permissions/v1" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "scope", "resources"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["own", "team", "all"] },
          "resources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "anyOf": [
                { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
                { "const": "*" }
              ]
            }
          },
          "actions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["create", "read", "update", "delete", "list"] }
          }
        }
      }
    },
    "roleMappings": {
      "type": "object",
      "description": "AI 角色 → 平台权限点；任一命中即视为该角色。缺省时匹配 JWT role 或同名权限点。",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
