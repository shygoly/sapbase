{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/blueprint-rules.schema.json",
  "title": "Blueprint Rules Layer",
  "description": "包内 rules.json 的形状：校验 / 审批 / 记账三类规则。只描述可静态判定的引用与字面量；expression / eval / script / lambda / fn 一类无法静态判定的字段是有意拒绝，不是碰巧没定义。跨文件判据（实体/字段/事件存在、借贷平衡）由编译器负责。",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules", "validation", "approval", "accounting"],
  "not": {
    "anyOf": [
      { "required": ["expression"] },
      { "required": ["eval"] },
      { "required": ["script"] },
      { "required": ["lambda"] },
      { "required": ["fn"] }
    ]
  },
  "properties": {
    "rules": { "const": "blueprint-rules/v1" },
    "validation": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationRule" }
    },
    "approval": {
      "type": "array",
      "items": { "$ref": "#/$defs/approvalRule" }
    },
    "accounting": {
      "type": "array",
      "items": { "$ref": "#/$defs/accountingRule" }
    }
  },
  "$defs": {
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 1
    },
    "entityName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "forbidEval": {
      "not": {
        "anyOf": [
          { "required": ["expression"] },
          { "required": ["eval"] },
          { "required": ["script"] },
          { "required": ["lambda"] },
          { "required": ["fn"] }
        ]
      }
    },
    "validationRule": {
      "allOf": [
        { "$ref": "#/$defs/forbidEval" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "entity", "field", "rule", "message"],
          "properties": {
            "id": { "$ref": "#/$defs/ruleId" },
            "entity": { "$ref": "#/$defs/entityName" },
            "field": { "$ref": "#/$defs/fieldName" },
            "rule": {
              "enum": [
                "required",
                "greaterThan",
                "lessThan",
                "minLength",
                "maxLength",
                "pattern",
                "oneOf",
                "unique"
              ]
            },
            "value": {},
            "message": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "rule": { "enum": ["greaterThan", "lessThan"] } },
                "required": ["rule"]
              },
              "then": {
                "required": ["value"],
                "properties": { "value": { "type": "number" } }
              }
            },
            {
              "if": {
                "properties": { "rule": { "enum": ["minLength", "maxLength"] } },
                "required": ["rule"]
              },
              "then": {
                "required": ["value"],
                "properties": { "value": { "type": "integer", "minimum": 0 } }
              }
            },
            {
              "if": {
                "properties": { "rule": { "const": "pattern" } },
                "required": ["rule"]
              },
              "then": {
                "required": ["value"],
                "properties": { "value": { "type": "string", "minLength": 1 } }
              }
            },
            {
              "if": {
                "properties": { "rule": { "const": "oneOf" } },
                "required": ["rule"]
              },
              "then": {
                "required": ["value"],
                "properties": { "value": { "type": "array", "minItems": 1 } }
              }
            }
          ]
        }
      ]
    },
    "approvalRule": {
      "allOf": [
        { "$ref": "#/$defs/forbidEval" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "entity", "when", "steps"],
          "properties": {
            "id": { "$ref": "#/$defs/ruleId" },
            "entity": { "$ref": "#/$defs/entityName" },
            "when": {
              "type": "string",
              "minLength": 1,
              "description": "受限表达式文本（见 docs/protocols/blueprint-delivery.md）。编译期只抽取字段引用、不求值。"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role"],
                "properties": {
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "accountingRule": {
      "allOf": [
        { "$ref": "#/$defs/forbidEval" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "on", "entries"],
          "properties": {
            "id": { "$ref": "#/$defs/ruleId" },
            "on": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$",
              "description": "已声明事件 Entity.state，必须能在 flows.json 展开的事件里解析到"
            },
            "entries": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["account", "side", "amount"],
                "properties": {
                  "account": { "type": "string", "minLength": 1 },
                  "side": { "enum": ["debit", "credit"] },
                  "amount": {
                    "oneOf": [
                      { "type": "number" },
                      { "type": "string", "minLength": 1 }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
