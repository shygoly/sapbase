{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/blueprint-semantic.schema.json",
  "title": "Blueprint Semantic Layer",
  "description": "包内 semantic.json 的形状（业务对象、字段、关系、状态、迁移）。**跨字段判据**（初始态唯一、存在终态、无不可达态、迁移目标已声明）不在这里 —— 由编译器确定性判定，见 backend/src/blueprint/compiler.ts。",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fields", "states"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "type": {
                  "enum": ["text", "number", "decimal", "boolean", "date", "datetime", "i32", "reference"]
                },
                "required": { "type": "boolean" },
                "reference": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
              },
              "allOf": [
                {
                  "if": { "properties": { "type": { "const": "reference" } }, "required": ["type"] },
                  "then": { "required": ["reference"] }
                }
              ]
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "target"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "type": { "enum": ["belongsTo", "hasOne", "hasMany", "manyToMany"] },
                "target": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
              }
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "initial": { "type": "boolean" },
                "final": { "type": "boolean" }
              }
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "type": "string", "minLength": 1 },
                "to": { "type": "string", "minLength": 1 },
                "rule": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
