{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/data-scope.schema.json",
  "title": "Data Scope v1",
  "description": "平台数据范围的持久化形状：范围域/节点/成员/绑定/策略/谓词。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dimension": { "$ref": "#/$defs/scopeDimension" },
    "node": { "$ref": "#/$defs/scopeNode" },
    "membership": { "$ref": "#/$defs/scopeMembership" },
    "binding": { "$ref": "#/$defs/scopeBinding" },
    "policy": { "$ref": "#/$defs/dataPolicy" },
    "expr": { "$ref": "#/$defs/scopeExpr" }
  },
  "$defs": {
    "snakeKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "uuid": { "type": "string", "format": "uuid" },
    "scopeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "key", "name"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/uuid" },
        "key": { "$ref": "#/$defs/snakeKey" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "config": { "type": ["object", "null"] },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "scopeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "dimensionId", "path", "depth", "name"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/uuid" },
        "dimensionId": { "$ref": "#/$defs/uuid" },
        "parentId": { "type": ["string", "null"], "format": "uuid" },
        "path": { "type": "string", "pattern": "^/" },
        "depth": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "code": { "type": ["string", "null"] },
        "metadata": { "type": ["object", "null"] },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "scopeMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "subjectType", "subjectId", "nodeId", "positionKey"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/uuid" },
        "subjectType": { "enum": ["user", "role", "group"] },
        "subjectId": { "type": "string", "minLength": 1 },
        "nodeId": { "$ref": "#/$defs/uuid" },
        "positionKey": { "type": "string", "minLength": 1 },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" },
        "metadata": { "type": ["object", "null"] }
      }
    },
    "relationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromField", "actorField"],
      "properties": {
        "entity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "table": { "$ref": "#/$defs/snakeKey" },
        "fromField": { "$ref": "#/$defs/identifier" },
        "actorField": { "$ref": "#/$defs/identifier" }
      }
    },
    "scopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "resourceKey", "dimensionKey", "kind"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/uuid" },
        "resourceKey": { "type": "string", "minLength": 1 },
        "dimensionKey": { "$ref": "#/$defs/snakeKey" },
        "kind": { "enum": ["field", "owner", "relation"] },
        "field": { "type": ["string", "null"] },
        "relation": { "anyOf": [{ "$ref": "#/$defs/relationSpec" }, { "type": "null" }] },
        "writable": { "type": "boolean" }
      }
    },
    "scopeSubject": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "userId"], "properties": { "kind": { "const": "user" }, "userId": { "$ref": "#/$defs/uuid" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "roleKey"], "properties": { "kind": { "const": "role" }, "roleKey": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "groupKey"], "properties": { "kind": { "const": "group" }, "groupKey": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "positionKey"], "properties": { "kind": { "const": "position" }, "positionKey": { "type": "string" } } }
      ]
    },
    "scopeSpec": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "all" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "self" }, "field": { "$ref": "#/$defs/identifier" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dimension", "nodeIds"],
          "properties": {
            "kind": { "const": "nodes" },
            "dimension": { "$ref": "#/$defs/snakeKey" },
            "nodeIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uuid" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dimension", "anchor", "depth"],
          "properties": {
            "kind": { "const": "node" },
            "dimension": { "$ref": "#/$defs/snakeKey" },
            "anchor": { "const": "membership" },
            "positions": { "type": "array", "items": { "type": "string" } },
            "depth": { "enum": ["exact", "subtree", "ancestors"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "relation" },
            "relation": { "$ref": "#/$defs/relationSpec" }
          }
        }
      ]
    },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "name", "subject", "resourceKey", "actions", "effect", "scope"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/scopeSubject" },
        "resourceKey": { "type": "string", "minLength": 1 },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "effect": { "enum": ["allow", "deny"] },
        "scope": { "$ref": "#/$defs/scopeSpec" },
        "priority": { "type": "integer" },
        "status": { "enum": ["active", "inactive"] },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "fieldRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "column"], "properties": { "kind": { "const": "column" }, "table": { "type": "string" }, "column": { "$ref": "#/$defs/identifier" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "column", "path"], "properties": { "kind": { "const": "jsonb" }, "table": { "type": "string" }, "column": { "$ref": "#/$defs/identifier" }, "path": { "type": "string", "minLength": 1 } } }
      ]
    },
    "scopeValue": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": {} } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "field"], "properties": { "kind": { "const": "row" }, "field": { "$ref": "#/$defs/identifier" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "actor" }, "field": { "$ref": "#/$defs/identifier" } } }
      ]
    },
    "scopeExpr": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "enum": ["all", "none"] } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "field", "value"], "properties": { "op": { "const": "eq" }, "field": { "$ref": "#/$defs/fieldRef" }, "value": { "$ref": "#/$defs/scopeValue" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "field", "values"], "properties": { "op": { "const": "in" }, "field": { "$ref": "#/$defs/fieldRef" }, "values": { "type": "array", "items": { "$ref": "#/$defs/scopeValue" } } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "source", "where"], "properties": { "op": { "const": "exists" }, "source": { "type": "object" }, "where": { "$ref": "#/$defs/scopeExpr" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": { "op": { "enum": ["and", "or"] }, "args": { "type": "array", "items": { "$ref": "#/$defs/scopeExpr" } } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "arg"], "properties": { "op": { "const": "not" }, "arg": { "$ref": "#/$defs/scopeExpr" } } }
      ]
    }
  }
}
