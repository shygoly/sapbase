{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/model-gateway.schema.json",
  "title": "Model Gateway Contract",
  "description": "Provider-neutral 模型网关请求/响应/trace 与 secret reference 的冻结契约（1.3）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "payload"],
  "oneOf": [
    { "properties": { "kind": { "const": "request" }, "payload": { "$ref": "#/$defs/request" } } },
    { "properties": { "kind": { "const": "response" }, "payload": { "$ref": "#/$defs/response" } } },
    { "properties": { "kind": { "const": "chunk" }, "payload": { "$ref": "#/$defs/chunk" } } },
    { "properties": { "kind": { "const": "trace" }, "payload": { "$ref": "#/$defs/trace" } } },
    { "properties": { "kind": { "const": "secret-ref" }, "payload": { "$ref": "#/$defs/secretRef" } } }
  ],
  "properties": {
    "kind": { "enum": ["request", "response", "chunk", "trace", "secret-ref"] },
    "payload": { "type": "object" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "task": { "enum": ["intent", "design", "vision", "evaluation"] },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "messages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/message" } },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "metadata": { "type": "object" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "provider",
        "model",
        "resolvedModelId",
        "credentialSource",
        "latencyMs"
      ],
      "properties": {
        "requestId": { "$ref": "#/$defs/uuid" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 50 },
        "model": { "type": "string", "maxLength": 100 },
        "resolvedModelId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requestedModelId": { "type": ["string", "null"], "maxLength": 64 },
        "credentialSource": { "enum": ["secret-ref", "legacy-inline"] },
        "latencyMs": { "type": "integer", "minimum": 0 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "provider", "model", "modelRowId", "trace"],
      "properties": {
        "text": { "type": "string" },
        "raw": {},
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "modelRowId": { "type": "string", "minLength": 1 },
        "trace": { "$ref": "#/$defs/trace" }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta", "done", "trace"],
      "properties": {
        "delta": { "type": "string" },
        "done": { "type": "boolean" },
        "trace": { "$ref": "#/$defs/trace" }
      }
    },
    "secretRef": {
      "type": "string",
      "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/[^\\u0000]+)$",
      "maxLength": 255
    }
  }
}
