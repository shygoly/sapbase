{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sapbase.local/schemas/space-delta.schema.json",
  "title": "Space Delta v2",
  "description": "声明层增量协议；最终结构（manifest/IR/source/db/secrets）不在可写路径内。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "baseVersion", "operations"],
  "properties": {
    "protocol": { "const": "space-delta/v2" },
    "baseVersion": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": {
            "enum": ["add", "update", "remove", "replace", "link", "unlink", "reorder"]
          },
          "path": {
            "type": "string",
            "pattern": "^/(semantic|pages|menus|permissions|rules|flows|experience|ui)(/|$)"
          },
          "value": {},
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
