{
  "name": "speckit",
  "root": "speckit",
  "sourceRoot": "speckit/src",
  "projectType": "application",
  "tags": ["type:app", "scope:portal", "runtime:browser"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "speckit" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "speckit" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "speckit" }
    }
  }
}
