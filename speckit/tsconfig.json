{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "downlevelIteration": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "./public/*"
      ],
      "@sap/ui-kit": [
        "../libs/ui-kit/src/index.ts"
      ],
      "@sap/ui-kit/*": [
        "../libs/ui-kit/src/*"
      ],
      "@sap/ui-theme": [
        "../libs/ui-theme/src/index.ts"
      ],
      "@sap/ui-theme/*": [
        "../libs/ui-theme/src/*"
      ],
      "@sap/api-client": [
        "../libs/api-client/src/index.ts"
      ],
      "@sap/api-client/*": [
        "../libs/api-client/src/*"
      ],
      "@sap/shared-state": [
        "../libs/shared-state/src/index.ts"
      ],
      "@sap/shared-state/*": [
        "../libs/shared-state/src/*"
      ],
      "@sap/ui-runtime": [
        "../libs/ui-runtime/src/index.ts"
      ],
      "@sap/ui-runtime/*": [
        "../libs/ui-runtime/src/*"
      ],
      "@sap/ui-layout": [
        "../libs/ui-layout/src/index.ts"
      ],
      "@sap/ui-layout/*": [
        "../libs/ui-layout/src/*"
      ]
    },
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "__CLEANUP__"
  ],
  "moduleResolution": [
    "node_modules",
    ".next",
    "node"
  ]
}
