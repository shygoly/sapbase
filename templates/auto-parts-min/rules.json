{
  "rules": "blueprint-rules/v1",
  "validation": [
    {
      "id": "so-qty-positive",
      "entity": "SalesOrder",
      "field": "quantity",
      "rule": "greaterThan",
      "value": 0,
      "message": "销售数量必须大于 0"
    },
    {
      "id": "so-price-nonneg",
      "entity": "SalesOrder",
      "field": "unitPrice",
      "rule": "greaterOrEqual",
      "value": 0,
      "message": "单价不能为负"
    },
    {
      "id": "part-no-required",
      "entity": "Part",
      "field": "partNo",
      "rule": "required",
      "message": "物料号不能为空"
    }
  ],
  "approval": [
    {
      "id": "so-large-quantity",
      "entity": "SalesOrder",
      "when": "quantity > 100",
      "steps": [
        {
          "role": "sales-manager"
        }
      ]
    }
  ],
  "accounting": []
}
