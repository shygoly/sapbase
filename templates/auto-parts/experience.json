{
  "experience": "blueprint-experience/v1",
  "priority": [
    {
      "entity": "SalesOrder",
      "fields": ["customer", "quantity"]
    }
  ],
  "confirm": [
    {
      "action": "SalesOrder.confirmed",
      "when": {
        "field": "SalesOrder.quantity",
        "op": "greaterThan",
        "value": 100
      }
    }
  ],
  "automate": [
    {
      "action": "available-inventory"
    }
  ],
  "surfaces": [
    {
      "id": "sales-order.review",
      "when": {
        "entity": "SalesOrder",
        "state": "draft"
      }
    }
  ]
}
