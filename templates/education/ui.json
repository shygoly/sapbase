      "label": "课程建设",
      "path": "/education/courses",
      "icon": "book",
      "order": 2,
      "permissions": [
        "education.course.read"
      ]
    },
    {
      "identifier": "education-classes",
      "label": "教学运营",
      "path": "/education/classes",
      "icon": "users",
      "order": 3,
      "permissions": [
        "education.class.read"
      ]
    },
    {
      "identifier": "education-assessments",
      "label": "测评",
      "path": "/education/assessments",
      "icon": "clipboard",
      "order": 4,
      "permissions": [
        "education.assessment.read"
      ]
    },
    {
      "identifier": "education-analytics",
      "label": "学情看板",
      "path": "/education/analytics",
      "icon": "chart",
      "order": 5,
      "permissions": [
        "education.analytics.read"
      ]
    },
    {
      "identifier": "education-student",
      "label": "学习中心",
      "path": "/education/student",
      "icon": "graduation",
      "order": 6,
      "permissions": [
        "education.course.read"
      ]
    }
  ]
}
